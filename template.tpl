  add_to_cart: ['addtocart', 'addcart', 'cartadd', 'addproducttocart'],
  remove_from_cart: ['removefromcart', 'cartremove', 'removecart'],
  view_cart: ['viewcart', 'cartview', 'cart'],
  add_to_wishlist: ['addtowishlist', 'wishlistadd'],
  begin_checkout: ['begincheckout', 'checkout', 'startcheckout', 'initiatecheckout', 'checkoutstarted'],
  add_shipping_info: ['addshippinginfo', 'shippinginfo', 'checkoutshipping'],
  add_payment_info: ['addpaymentinfo', 'paymentinfo', 'checkoutpayment', 'addbilling'],
  purchase: ['purchase', 'transaction', 'orderplaced', 'ordercomplete', 'ordercompleted', 'completepayment', 'checkoutcomplete', 'conversion', 'sale'],
  refund: ['refund', 'orderrefund', 'returnorder'],
  search: ['search', 'sitesearch', 'searchresults', 'viewsearchresults'],
  sign_up: ['signup', 'registration', 'register', 'completeregistration', 'accountcreated'],
  login: ['login', 'signin'],
  generate_lead: ['generatelead', 'lead', 'formsubmit', 'formsubmission', 'contactformsubmit', 'submitform'],
  subscribe: ['subscribe', 'newslettersignup', 'subscription'],
  contact: ['contact', 'callclick', 'phoneclick', 'whatsappclick'],
  page_view: ['pageview', 'pv', 'virtualpageview', 'gtmdom', 'gtmjs']
};

const canonicalEvent = (rawEvent) => {
  const key = norm(rawEvent);
  if (key === '') return undefined;
  const names = Object.keys(EVENT_ALIASES);
  for (let i = 0; i < names.length; i++) {
    if (key === norm(names[i])) return names[i];
    if (EVENT_ALIASES[names[i]].indexOf(key) > -1) return names[i];
  }
  return undefined;
};

// ---------------------------------------------------------------------------
// Canonical model
// ---------------------------------------------------------------------------
const buildModel = (source, overrides) => {
  const entries = flatten(source);
  const model = { items: [], user: {}, page: {}, click_ids: {} };

  const rawEvent = pickAny(entries, ['event', 'eventname', 'eventtype', 'en', 'name'], 'items.');
  if (!isEmpty(rawEvent)) model.raw_event = makeString(rawEvent);
  model.event = canonicalEvent(model.raw_event);

  const topFields = Object.keys(TOP_ALIASES);
  for (let i = 0; i < topFields.length; i++) {
    const field = topFields[i];
    const value = pickAny(entries, TOP_ALIASES[field], 'items.');
    if (!isEmpty(value)) model[field] = value;
  }

  // transaction_id: plain "id" only counts inside an order/purchase context
  let transactionId = pickAny(entries, ['transactionid', 'orderid', 'ordernumber', 'orderno', 'invoiceid', 'purchaseid', 'checkoutid'], 'items.');
  if (isEmpty(transactionId)) transactionId = pick(entries, ['id'], 'purchase', 'items.');
  if (isEmpty(transactionId)) transactionId = pick(entries, ['id'], 'actionfield', 'items.');
  if (isEmpty(transactionId)) transactionId = pick(entries, ['id'], 'transaction', 'items.');
  if (isEmpty(transactionId)) transactionId = pick(entries, ['id'], 'order', 'items.');
  if (!isEmpty(transactionId)) model.transaction_id = makeString(transactionId);
  if (!isEmpty(model.event_id)) model.event_id = makeString(model.event_id);

  const userFields = Object.keys(USER_ALIASES);
  for (let u = 0; u < userFields.length; u++) {
    const value = pickAny(entries, USER_ALIASES[userFields[u]], 'items.');
    if (!isEmpty(value)) model.user[userFields[u]] = value;
  }

  const pageFields = Object.keys(PAGE_ALIASES);
  for (let p = 0; p < pageFields.length; p++) {
    const value = pickAny(entries, PAGE_ALIASES[pageFields[p]], 'items.');
    if (!isEmpty(value)) model.page[pageFields[p]] = value;
  }

  for (let c = 0; c < CLICK_ID_KEYS.length; c++) {
    const value = pickAny(entries, [CLICK_ID_KEYS[c]]);
    if (!isEmpty(value)) model.click_ids[CLICK_ID_KEYS[c]] = value;
  }

  const rawItems = findItems(source);
  if (getType(rawItems) === 'array') {
    const max = rawItems.length < 200 ? rawItems.length : 200;
    for (let it = 0; it < max; it++) {
      if (getType(rawItems[it]) === 'object') model.items.push(mapItem(rawItems[it]));
    }
  }

  // Manual overrides win over automatic detection
  if (getType(overrides) === 'array') {
    for (let o = 0; o < overrides.length; o++) {
      const row = overrides[o];
      if (!row || isEmpty(row.field) || isEmpty(row.path)) continue;
      const value = getByPath(source, row.path);
      if (isEmpty(value)) continue;
      const field = makeString(row.field);
      if (field.indexOf('user.') === 0) model.user[field.split('.')[1]] = value;
      else if (field.indexOf('page.') === 0) model.page[field.split('.')[1]] = value;
      else if (field === 'event') { model.raw_event = makeString(value); model.event = canonicalEvent(value) || model.event; }
      else model[field] = value;
    }
  }

  if (!isEmpty(model.value)) model.value = num(model.value);
  if (!isEmpty(model.tax)) model.tax = num(model.tax);
  if (!isEmpty(model.shipping)) model.shipping = num(model.shipping);

  if (isEmpty(model.currency) && model.items.length > 0 && !isEmpty(model.items[0].currency)) {
    model.currency = model.items[0].currency;
  }

  if (isEmpty(model.value) && calculateValue && model.items.length > 0) {
    let total = 0;
    let usable = false;
    for (let v = 0; v < model.items.length; v++) {
      const price = model.items[v].price;
      if (isEmpty(price)) continue;
      const qty = isEmpty(model.items[v].quantity) ? 1 : model.items[v].quantity;
      total = total + price * qty;
      usable = true;
    }
    if (usable) {
      model.value = total;
      model.value_source = 'calculated_from_items';
    }
  }

  return model;
};

