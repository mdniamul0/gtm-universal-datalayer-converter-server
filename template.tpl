// Removes empty values, or replaces them with the configured placeholder.
const clean = (obj) => {
  const out = {};
  const keys = Object.keys(obj);
  for (let i = 0; i < keys.length; i++) {
    const value = obj[keys[i]];
    if (isEmpty(value)) {
      if (missingMode === 'placeholder') out[keys[i]] = placeholderValue;
      else if (missingMode === 'empty_string') out[keys[i]] = '';
      continue;
    }
    if (getType(value) === 'object' && Object.keys(value).length === 0) continue;
    if (getType(value) === 'array' && value.length === 0) continue;
    out[keys[i]] = value;
  }
  return out;
};

const missing = (value) => {
  if (!isEmpty(value)) return value;
  if (missingMode === 'placeholder') return placeholderValue;
  if (missingMode === 'empty_string') return '';
  return undefined;
};

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
const source = readSource();
const model = buildModel(source, data.manualMapping);
const output = buildOutput(data.platform || 'normalized', model);

if (data.enableLogging) {
  logToConsole('Universal Data Layer Converter | platform: ' + (data.platform || 'normalized'));
  logToConsole('Universal Data Layer Converter | normalized model: ' + JSON.stringify(model));
  logToConsole('Universal Data Layer Converter | output: ' + JSON.stringify(output));
}

if (data.outputMode === 'event') {
  const eventName = output.event_name || output.event || output.eventName || model.event;
  return missing(eventName);
}

if (data.outputMode === 'json') {
  return JSON.stringify(output);
}

if (data.outputMode === 'field') {
  return missing(getByPath(output, data.outputPath));
}

return output;

