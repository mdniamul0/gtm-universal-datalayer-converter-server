const getAllEventData = require('getAllEventData');
const getType = require('getType');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const Object = require('Object');
const JSON = require('JSON');
const sha256Sync = require('sha256Sync');
const logToConsole = require('logToConsole');

const readSource = () => {
  if (data.sourceMode === 'variable') {
    return getType(data.sourceObject) === 'object' ? data.sourceObject : {};
  }
  const eventData = getAllEventData();
  return getType(eventData) === 'object' ? eventData : {};
};

const isHashed = (text) => {
  if (text.length !== 64) return false;
  for (let i = 0; i < text.length; i++) {
    const c = text.charAt(i);
    const hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
    if (!hex) return false;
  }
  return true;
};

const digitsOnly = (text) => {
  let out = '';
  for (let i = 0; i < text.length; i++) {
    const c = text.charAt(i);
    if (c >= '0' && c <= '9') out = out + c;
  }
  return out;
};

// Two distinct phone conventions exist across ad platforms and this template
// must not blur them:
//  - 'phone'      -> digits only, no leading "+", country code kept
//                    (Meta/TikTok/Snapchat/Pinterest/etc. Conversions APIs)
//  - 'phone_e164' -> E.164, i.e. digits with a mandatory leading "+"
//                    (Google Ads and Microsoft/Bing UET enhanced conversions
//                    both require this exact shape before hashing)
// The source number must already include its country code either way — this
// template does not invent or guess one.
const hash = (value, kind) => {
  if (getType(value) === 'undefined' || getType(value) === 'null' || value === '') return undefined;
  let text = makeString(value).trim().toLowerCase();
  if (isHashed(text)) return text; // already SHA-256 hex; never re-hash or reformat it
  if (kind === 'phone') text = digitsOnly(text);
  if (kind === 'phone_e164') text = '+' + digitsOnly(text);
  if (text === '' || text === '+') return undefined;
  // Normalization (trim/lowercase/phone formatting) always happens, even
  // with hashing turned off, per each platform's own guidance: send either
  // properly normalized *unhashed* data (so the platform can hash it) or
  // pre-hashed data yourself — never raw, unformatted PII.
  if (!data.hashUserData) return text;
  return sha256Sync(text, { outputEncoding: 'hex' });
};

const missingMode = data.missingMode || 'omit';
const placeholderValue = data.placeholderValue || 'Not Available';
const calculateValue = data.calculateValue === true;
const actionSource = data.actionSource;
const eventConversionType = data.eventConversionType;
// ---------------------------------------------------------------------------
// Universal Data Layer Converter — mapping engine
// Reads whatever structure the source object has and maps it to a canonical
// model, then formats that model for the selected platform.
// No value is ever invented: a field that is not found stays empty.
// ---------------------------------------------------------------------------

const norm = (value) => {
  const text = makeString(value).toLowerCase();
  let out = '';
  for (let i = 0; i < text.length; i++) {
    const c = text.charAt(i);
    if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) out = out + c;
  }
  return out;
};

const isEmpty = (value) => {
  const t = getType(value);
  return t === 'undefined' || t === 'null' || (t === 'string' && value === '');
};

const lastSegment = (path) => {
  const bits = path.split('.');
  return bits[bits.length - 1];
};

// Flattens any object into a list of leaf entries with their path and depth.
const flatten = (root) => {
  const entries = [];
  const walk = (node, path, depth) => {
    if (depth > 7 || entries.length > 1200) return;
    const t = getType(node);
    if (t === 'object') {
      const keys = Object.keys(node);
      for (let i = 0; i < keys.length; i++) {
        walk(node[keys[i]], path === '' ? keys[i] : path + '.' + keys[i], depth + 1);
      }
    } else if (t === 'array') {
      const max = node.length < 60 ? node.length : 60;
      for (let j = 0; j < max; j++) {
        walk(node[j], path + '.' + j, depth + 1);
      }
    } else if (!isEmpty(node)) {
      entries.push({ path: path, lower: path.toLowerCase(), key: norm(lastSegment(path)), value: node, depth: depth });
    }
  };
  walk(root, '', 0);
  return entries;
};

// Picks the shallowest leaf whose key matches an alias, honouring alias order.
const pick = (entries, aliases, mustContain, skipContain) => {
  for (let a = 0; a < aliases.length; a++) {
    let best;
    for (let i = 0; i < entries.length; i++) {
      const entry = entries[i];
      if (entry.key !== aliases[a]) continue;
      if (mustContain && entry.lower.indexOf(mustContain) === -1) continue;
      if (skipContain && entry.lower.indexOf(skipContain) > -1) continue;
      if (!best || entry.depth < best.depth) best = entry;
    }
    if (best) return best.value;
  }
  return undefined;
};

const pickAny = (entries, aliases, skipContain) => pick(entries, aliases, undefined, skipContain);

const getByPath = (root, path) => {
  if (!path) return undefined;
  let node = root;
  const bits = makeString(path).split('.');
  for (let i = 0; i < bits.length; i++) {
    if (getType(node) !== 'object' && getType(node) !== 'array') return undefined;
    node = node[bits[i]];
    if (getType(node) === 'undefined') return undefined;
  }
  return node;
};

const num = (value) => {
  if (isEmpty(value)) return undefined;
  const n = makeNumber(value);
  return n !== n ? undefined : n; // NaN check without isNaN
};

const ITEM_KEYS = ['itemid', 'productid', 'id', 'sku', 'itemname', 'productname', 'name', 'price', 'contentid', 'variantid'];

const looksLikeItem = (candidate) => {
  if (getType(candidate) !== 'object') return false;
  const keys = Object.keys(candidate);
  for (let i = 0; i < keys.length; i++) {
    if (ITEM_KEYS.indexOf(norm(keys[i])) > -1) return true;
  }
  return false;
};

const PREFERRED_ITEM_KEYS = ['items', 'products', 'lineitems', 'orderitems', 'cartitems', 'productlist', 'contents', 'basket'];

// Finds the first array in the source that looks like a list of products.
const findItems = (root) => {
  let found;
  const walk = (node, depth) => {
    if (found || depth > 6) return;
    const t = getType(node);
    if (t === 'array') {
      if (node.length > 0 && looksLikeItem(node[0])) found = node;
      return;
    }
    if (t !== 'object') return;
    const keys = Object.keys(node);
    for (let i = 0; i < keys.length; i++) {
      if (PREFERRED_ITEM_KEYS.indexOf(norm(keys[i])) > -1) {
        walk(node[keys[i]], depth + 1);
        if (found) return;
      }
    }
    for (let j = 0; j < keys.length; j++) {
      walk(node[keys[j]], depth + 1);
      if (found) return;
    }
  };
  walk(root, 0);
  return found;
};

const ITEM_ALIASES = {
  item_id: ['itemid', 'productid', 'contentid', 'skuid', 'sku', 'id', 'variantid', 'gtin', 'productcode'],
  item_name: ['itemname', 'productname', 'contentname', 'name', 'title', 'producttitle'],
  item_variant: ['itemvariant', 'variant', 'varianttitle', 'variantname', 'option', 'itemoption'],
  item_sku: ['itemsku', 'productsku', 'sku', 'skuid', 'skucode'],
  item_brand: ['itembrand', 'brand', 'vendor', 'manufacturer'],
  item_category: ['itemcategory', 'category', 'productcategory', 'categoryname', 'itemcategory1', 'producttype', 'collection'],
  price: ['price', 'itemprice', 'unitprice', 'productprice', 'priceamount', 'amount', 'value'],
  quantity: ['quantity', 'qty', 'itemquantity', 'productquantity', 'count'],
  currency: ['currency', 'currencycode', 'itemcurrency'],
  item_url: ['itemurl', 'producturl', 'url', 'link', 'permalink'],
  item_image: ['itemimage', 'imageurl', 'image', 'thumbnail', 'productimage'],
  position: ['index', 'position', 'listposition']
};

const mapItem = (rawItem) => {
  const entries = flatten(rawItem);
  const mapped = {};
  const fields = Object.keys(ITEM_ALIASES);
  for (let i = 0; i < fields.length; i++) {
    const field = fields[i];
    const value = pickAny(entries, ITEM_ALIASES[field]);
    if (!isEmpty(value)) mapped[field] = value;
  }
  if (!isEmpty(mapped.price)) mapped.price = num(mapped.price);
  if (!isEmpty(mapped.quantity)) mapped.quantity = num(mapped.quantity);
  if (!isEmpty(mapped.position)) mapped.position = num(mapped.position);
  // Every ad platform's item/content ID field is typed as a string. A data
  // layer that stores item_id/sku as a number (e.g. 12345) must not leak a
  // numeric type into content_ids/item_id output, so coerce explicitly.
  if (!isEmpty(mapped.item_id)) mapped.item_id = makeString(mapped.item_id);
  if (!isEmpty(mapped.item_sku)) mapped.item_sku = makeString(mapped.item_sku);
  return mapped;
};

