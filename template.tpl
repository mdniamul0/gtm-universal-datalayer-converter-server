const platformEvent = (platform, model) => {
  const map = EVENT_MAP[platform];
  if (map && model.event && map[model.event]) return map[model.event];
  if (model.raw_event) return model.raw_event;
  return model.event;
};

// ---------------------------------------------------------------------------
// Platform formatters
// ---------------------------------------------------------------------------
const listOf = (items, field) => {
  const out = [];
  for (let i = 0; i < items.length; i++) {
    if (!isEmpty(items[i][field])) out.push(items[i][field]);
  }
  return out;
};

const totalQuantity = (items) => {
  let total = 0;
  for (let i = 0; i < items.length; i++) {
    total = total + (isEmpty(items[i].quantity) ? 1 : items[i].quantity);
  }
  return items.length > 0 ? total : undefined;
};

const ga4Items = (items) => {
  const out = [];
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    out.push(clean({
      item_id: item.item_id,
      item_name: item.item_name,
      item_variant: item.item_variant,
      item_brand: item.item_brand,
      item_category: item.item_category,
      price: item.price,
      quantity: item.quantity,
      currency: item.currency,
      index: item.position
    }));
  }
  return out;
};

